{
  "$schema": "https://github.com/garrytan/gstack/docs/pregate.md#pregate-v1",
  "runner": "sh .gstack/run-go-tests.sh {files}",
  "dependencies": {
    "client_hints.go": ["client_hints_test.go"],
    "enums.go": ["parser_test.go"],
    "extensions.go": ["extensions_test.go", "helpers_test.go"],
    "helpers.go": ["helpers_test.go"],
    "mapper.go": ["parser_test.go"],
    "parser.go": ["parser_test.go", "client_hints_test.go"],
    "regexes_browser.go": ["parser_test.go"],
    "regexes_cpu.go": ["parser_test.go"],
    "regexes_device.go": ["parser_test.go"],
    "regexes_engine.go": ["parser_test.go"],
    "regexes_os.go": ["parser_test.go"],
    "example/main.go": [],
    "testdata/ua-ch.json": ["client_hints_test.go"],
    "testdata/extensions/*.json": ["extensions_test.go"],
    "README.md": [],
    "go.mod": [],
    "go.sum": [],
    "coverage.html": [],
    "coverage.out": [],
    "example/user_agents.csv": [],
    "test_output.log": [],
    ".gstack/run-go-tests.sh": [],
    ".gstack/pregate.json": []
  },
  "empty_lanes": [],
  "selection": {},
  "warn": ["lanes"],
  "allowlist": [
    {
      "finding": "pii.ip_public",
      "paths": [
        "testdata/extensions/extra-devices.json",
        "example/user_agents.csv"
      ],
      "reason": "UA 测试数据中的公网 IP，非凭证"
    }
  ],
  "strays": {
    "allow": [
      "coverage.html",
      "coverage.out",
      ".codegraph/",
      ".gstack/"
    ]
  }
}
